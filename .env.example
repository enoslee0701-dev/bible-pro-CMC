# ─── Modes ────────────────────────────────────────────────────────────────
# FREE  mode: leave ANTHROPIC_API_KEY unset. Keyless machine translation
#             (via MyMemory). AI auto-fix is disabled. Zero config.
# AI    mode: set ANTHROPIC_API_KEY. Claude translation + AI auto-fix.

# Your Anthropic API key (optional — set to enable AI mode).
# Get one at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Port the server listens on
PORT=3000

# Model used in AI mode (ignored in free mode).
# claude-haiku-4-5  -> lowest latency, best for fast real-time interpreting
# claude-sonnet-4-6 -> good balance of speed/quality
# claude-opus-4-8   -> highest quality
MODEL=claude-opus-4-8

# Optional: force free mode even when a key is present.
# TRANSLATOR=free

# Optional: a contact email raises the free provider's anonymous daily quota.
# MYMEMORY_EMAIL=you@example.com
