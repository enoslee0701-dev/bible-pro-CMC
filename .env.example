# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Port the server listens on
PORT=3000

# Model used for translation + auto-fix.
# claude-opus-4-8   -> highest quality (default)
# claude-sonnet-4-6 -> good balance of speed/quality
# claude-haiku-4-5  -> lowest latency, best for fast real-time interpreting
MODEL=claude-opus-4-8
